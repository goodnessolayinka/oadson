# ============================================================================
# OADSON environment template
# Copy to .env for local development. Never commit .env.
# In production, set these in your host's environment (Render, Railway, etc).
# Leave a value blank to disable the feature that needs it.
# ============================================================================

# ── Runtime ──
ENVIRONMENT=development
DEBUG=false
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
RENDER_EXTERNAL_URL=
RAILWAY_PUBLIC_DOMAIN=
LOGIN_PAGE_PATH=
SKILLS_DIR=skills
OADSON_HOME_ROOT=
ENABLE_PLANNER=false
ENGINEER_ENABLED=false
ENGINEER_TEST_MODEL=
WORKER_ENABLED=false
WORKER_URLS=
WORKER_ROUTE_TERMINAL=false

# ── Database ──
MONGODB_URI=
MONGO_URI=
DB_NAME=oadson

# ── Service auth (internal) ──
OADSON_SERVICE_TOKEN=
OADSON_ENGINEER_TOKEN=
INTERNAL_SECRET=
INTERNAL_SECRET_NEXT=

# ── Google OAuth (login + Gmail/Calendar/Drive/Docs/Tasks/Keep) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_API_KEY=

# ── AI providers ──
GEMINI_API_KEY=
GEMINI_THINKING_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
POLLINATIONS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_DAILY_CAP_USD=
DEEPSEEK_TOTAL_CAP_USD=
COREWEAVE_API_KEY=
COREWEAVE_API_KEY_2=
COREWEAVE_DAILY_CAP_USD=
COREWEAVE_TOTAL_CAP_USD=
COREWEAVE_2_DAILY_CAP_USD=
COREWEAVE_2_TOTAL_CAP_USD=
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_CAP_USD=
ANTHROPIC_TOTAL_CAP_USD=
ENGINEER_DAILY_CAP_USD=
ENGINEER_TOTAL_CAP_USD=
SPEND_LEDGER_PATH=

# ── File storage ──
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── GitHub (skill_creator + github skill; needs write scope to push) ──
GITHUB_TOKEN=
SKILL_CREATOR_GITHUB_OWNER=
SKILL_CREATOR_GITHUB_REPO=

# ── Messaging bridges ──
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_OWNER_LID=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_INSTANCE_ID_2=
GREEN_API_TOKEN_2=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── Browser ──
BROWSER_ENABLED=false
BROWSERLESS_URL=
PLAYWRIGHT_BROWSERS_PATH=

# ── Render (optional: lets the owner restart the worker on low memory) ──
RENDER_API_KEY=
RENDER_WORKER_SERVICE_ID=

# ── Third-party data skills (all optional) ──
NEWS_API_KEY=
OPENWEATHER_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Owner identity (kept out of code) ──
OADSON_OWNER_EMAIL=
# Comma-separated Google accounts allowed to log in. Empty = only dev@oadson.local.
OADSON_ALLOWED_EMAILS=
GOOGLE_OAUTH_REDIRECT_URI=
